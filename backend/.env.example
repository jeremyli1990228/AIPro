# ===== AI 平台后端环境变量 =====
# 复制本文件为 .env 并填写真实值

# 服务端口（Render/Railway 会自动注入 PORT，本地默认 8001）
PORT=8001

# 允许的前端来源（CORS），多个用逗号分隔
# GitHub Pages 地址、本地预览地址
ALLOWED_ORIGINS=https://jeremyli1990228.github.io,http://localhost:8000,http://127.0.0.1:8000

# ===== LLM 配置（与前端 DeepSeek 配置一致） =====
# Base URL（OpenAI 兼容接口）
LLM_BASE_URL=https://api.deepseek.com/v1
# API Key（务必保管好，不要提交到 GitHub）
LLM_API_KEY=sk-your-deepseek-api-key
# 模型名
LLM_MODEL=deepseek-chat

# ===== 可选：是否启用调试日志 =====
DEBUG=false
